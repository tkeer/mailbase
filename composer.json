{
    "name": "axn/preprod-mailcatcher-for-laravel",
    "description": "Catch laravel emails for preproduction",
    "keywords": ["laravel", "preprod", "development", "mail"],
    "homepage": "https://github.com/AXN-Informatique/preprod-mailcatcher-for-laravel",
    "support": {
        "issues": "https://github.com/AXN-Informatique/preprod-mailcatcher-for-laravel/issues"
    },
    "authors": [{
            "name": "AXN Informatique",
            "email": "developpement@axn.fr"
        }
    ],
    "autoload": {
        "psr-4": {
            "Axn\\MailCatcher\\": "src/"
        }
    },
    "license": "MIT",
    "require": {
        "axn/laravel-app-informations": "^5.0.2",
        "laravel/framework": "^10.0 || ^11.0"
    },
    "require-dev": {
        "laravel/pint": "^1.15.1",
        "driftingly/rector-laravel": "^1.1",
        "rector/rector": "^1.0.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Axn\\MailCatcher\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
